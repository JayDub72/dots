# ~/.ssh/config
# Lives in this repo and gets symlinked into place by install.sh
# (see README.md -> DOTFILE_NAMES). Safe to version-control: no secrets,
# only host aliases and key *paths*. Never put a private key file here
# (see .gitignore_global).
#
# Rebuilt 2026-09-05 from the messy live config that was on this Mac:
# merged duplicate `Host *`/`Host monitor` blocks, removed the 1Password
# IdentityAgent override (native Keychain instead - confirm 1Password's
# "Use the SSH Agent" toggle in Settings -> Developer stays OFF), fixed
# `HostNAME` -> `HostName`, fixed `User JayDub72` -> `User git` on
# github.com, added IdentitiesOnly, and pointed IdentityFile at the actual
# generated key (~/.ssh/id_ed25519 - no `_jason` suffix, that was the old
# key's name). Verified working: `ssh -T git@github.com` authenticates
# cleanly.
#
# `nas` added 2026-09-19 for the Synology backup/restore scripts
# (docs/planning.md step 6) — HostName confirmed via DNS resolution to
# match the known NAS IP from docs/ssh-setup-plan.md's Ansible inventory
# (192.168.1.210). Uses the same key/User defaults as every other host
# below — confirm the DSM account is actually named `jason` (the `User *`
# default) and that this key has been copied to it (`ssh-copy-id`,
# ssh-setup-plan.md Phase 8 pattern), or `dots backup`/`dots restore` will
# fail to authenticate. `ansible` is still intentionally absent.

# ── Defaults applied to every host ──────────────────────────────────────────
Host *
    IgnoreUnknown AddKeysToAgent,UseKeychain
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 30
    ExitOnForwardFailure yes
    User jason

# ── GitHub ───────────────────────────────────────────────────────────────────
Host github.com
    HostName github.com
    User git

# ── Proxmox cluster (3 nodes) ───────────────────────────────────────────────
Host donnager
    HostName 192.168.1.199

Host rocinate
    HostName 192.168.1.198

Host razorback
    HostName 192.168.1.197

# ── NAS ──────────────────────────────────────────────────────────────────────
Host nas
    HostName nasbox.home.lan

# ── VMs / LXCs (routable on the LAN - no ProxyJump needed) ─────────────────
Host automate
    HostName automate.home.lan

Host monitor
    HostName monitor.home.lan

Host photo
    HostName photo.home.lan

Host plex
    HostName media.home.lan

Host prism
    HostName recipe.home.lan

Host mealie
    HostName recipe.home.lan

Host seedbox
    HostName seedbox.home.lan

Host dev_vm
    HostName dev.home.lan
